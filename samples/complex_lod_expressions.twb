<?xml version='1.0' encoding='utf-8' ?>
<!--
Complex LOD Expressions Sample
Tests FIXED, INCLUDE, and EXCLUDE Level of Detail expressions
Conversion complexity: HIGH
-->
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <!-- Parameters datasource -->
    <datasource name='Parameters'>
      <column caption='Date Granularity' name='[Parameter.DateGranularity]' datatype='string' role='dimension'>
        <calculation formula='"Month"' />
        <members>
          <member value='"Day"' />
          <member value='"Week"' />
          <member value='"Month"' />
          <member value='"Quarter"' />
          <member value='"Year"' />
        </members>
      </column>
      <column caption='Top N' name='[Parameter.TopN]' datatype='integer' role='measure'>
        <calculation formula='10' />
        <range granularity='1' min='1' max='100' />
      </column>
    </datasource>
    
    <!-- Main Sales datasource with complex calculations -->
    <datasource name='Sales.SalesData' caption='Sales Data'>
      <connection class='sqlserver' server='sales-db.company.com' port='1433' dbname='SalesAnalytics' username='analytics_user'>
        <relation name='Sales' table='[dbo].[Sales]' type='table' />
        <relation name='Products' table='[dbo].[Products]' type='table' />
        <relation name='Customers' table='[dbo].[Customers]' type='table' />
        <relation name='SalesJoined' type='join' join='inner'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Sales].[ProductID]' />
              <expression op='[Products].[ProductID]' />
            </expression>
          </clause>
        </relation>
      </connection>
      
      <!-- Base columns -->
      <column name='[Order Date]' caption='Order Date' datatype='datetime' role='dimension' />
      <column name='[Customer ID]' caption='Customer ID' datatype='string' role='dimension' />
      <column name='[Customer Name]' caption='Customer Name' datatype='string' role='dimension' />
      <column name='[Customer Segment]' caption='Customer Segment' datatype='string' role='dimension' />
      <column name='[Product ID]' caption='Product ID' datatype='string' role='dimension' />
      <column name='[Product Name]' caption='Product Name' datatype='string' role='dimension' />
      <column name='[Category]' caption='Category' datatype='string' role='dimension' />
      <column name='[Sub-Category]' caption='Sub-Category' datatype='string' role='dimension' />
      <column name='[Region]' caption='Region' datatype='string' role='dimension' />
      <column name='[State]' caption='State' datatype='string' role='dimension' />
      <column name='[City]' caption='City' datatype='string' role='dimension' />
      <column name='[Sales]' caption='Sales' datatype='real' role='measure' aggregation='sum' />
      <column name='[Quantity]' caption='Quantity' datatype='integer' role='measure' aggregation='sum' />
      <column name='[Discount]' caption='Discount' datatype='real' role='measure' aggregation='avg' />
      <column name='[Profit]' caption='Profit' datatype='real' role='measure' aggregation='sum' />
      
      <!-- FIXED LOD Expressions -->
      <column name='[Calculation_TotalSalesFixed]' caption='Total Sales (FIXED)' datatype='real' role='measure'>
        <calculation formula='{FIXED : SUM([Sales])}' />
      </column>
      
      <column name='[Calculation_SalesByCustomerFixed]' caption='Customer Total Sales' datatype='real' role='measure'>
        <calculation formula='{FIXED [Customer ID] : SUM([Sales])}' />
      </column>
      
      <column name='[Calculation_SalesByRegionCategoryFixed]' caption='Region-Category Sales' datatype='real' role='measure'>
        <calculation formula='{FIXED [Region], [Category] : SUM([Sales])}' />
      </column>
      
      <column name='[Calculation_FirstOrderDate]' caption='Customer First Order Date' datatype='date' role='dimension'>
        <calculation formula='{FIXED [Customer ID] : MIN([Order Date])}' />
      </column>
      
      <column name='[Calculation_AvgOrderValueByCustomer]' caption='Avg Order Value per Customer' datatype='real' role='measure'>
        <calculation formula='{FIXED [Customer ID], [Order Date] : SUM([Sales])}' />
      </column>
      
      <!-- INCLUDE LOD Expressions -->
      <column name='[Calculation_SalesIncludeCity]' caption='Sales Including City' datatype='real' role='measure'>
        <calculation formula='{INCLUDE [City] : SUM([Sales])}' />
      </column>
      
      <column name='[Calculation_AvgSalesIncludeProduct]' caption='Avg Sales Including Product' datatype='real' role='measure'>
        <calculation formula='{INCLUDE [Product ID] : AVG([Sales])}' />
      </column>
      
      <column name='[Calculation_OrderCountIncludeDate]' caption='Daily Order Count' datatype='integer' role='measure'>
        <calculation formula='{INCLUDE [Order Date] : COUNTD([Customer ID])}' />
      </column>
      
      <!-- EXCLUDE LOD Expressions -->
      <column name='[Calculation_SalesExcludeState]' caption='Sales Excluding State' datatype='real' role='measure'>
        <calculation formula='{EXCLUDE [State] : SUM([Sales])}' />
      </column>
      
      <column name='[Calculation_SalesExcludeProduct]' caption='Sales Excluding Product' datatype='real' role='measure'>
        <calculation formula='{EXCLUDE [Product ID], [Product Name] : SUM([Sales])}' />
      </column>
      
      <column name='[Calculation_AvgExcludeCity]' caption='Avg Sales Excluding City' datatype='real' role='measure'>
        <calculation formula='{EXCLUDE [City] : AVG([Sales])}' />
      </column>
      
      <!-- Nested LOD Expressions -->
      <column name='[Calculation_CustomerVsTotal]' caption='Customer % of Total' datatype='real' role='measure'>
        <calculation formula='{FIXED [Customer ID] : SUM([Sales])} / {FIXED : SUM([Sales])}' />
      </column>
      
      <column name='[Calculation_RegionVsCategory]' caption='Region Share in Category' datatype='real' role='measure'>
        <calculation formula='SUM([Sales]) / {FIXED [Category] : SUM([Sales])}' />
      </column>
      
      <column name='[Calculation_NewCustomerSales]' caption='New Customer Sales' datatype='real' role='measure'>
        <calculation formula='IF [Order Date] = {FIXED [Customer ID] : MIN([Order Date])} THEN [Sales] ELSE 0 END' />
      </column>
      
      <column name='[Calculation_RepeatCustomerFlag]' caption='Is Repeat Customer' datatype='boolean' role='dimension'>
        <calculation formula='{FIXED [Customer ID] : COUNTD([Order Date])} > 1' />
      </column>
      
      <!-- Complex nested LOD with conditionals -->
      <column name='[Calculation_TopCustomerFlag]' caption='Is Top Customer' datatype='boolean' role='dimension'>
        <calculation formula='{FIXED [Customer ID] : SUM([Sales])} >= 
          {FIXED : PERCENTILE({FIXED [Customer ID] : SUM([Sales])}, 0.9)}' />
      </column>
      
      <column name='[Calculation_CohortSales]' caption='Cohort Total Sales' datatype='real' role='measure'>
        <calculation formula='{FIXED DATETRUNC("month", {FIXED [Customer ID] : MIN([Order Date])}) : SUM([Sales])}' />
      </column>
    </datasource>
  </datasources>
  
  <worksheets>
    <!-- Worksheet 1: Customer Analysis with FIXED LOD -->
    <worksheet name='Customer LOD Analysis'>
      <table>
        <panes>
          <pane>
            <mark class='bar' />
          </pane>
        </panes>
        <rows>[Sales.SalesData].[Calculation_SalesByCustomerFixed]</rows>
        <cols>[Sales.SalesData].[Customer Name]</cols>
      </table>
      <datasource-dependencies datasource='Sales.SalesData'>
        <column name='[Customer Name]' />
        <column name='[Calculation_SalesByCustomerFixed]' />
      </datasource-dependencies>
      <filter column='[Sales.SalesData].[Customer Segment]'>
        <groupfilter function='union'>
          <groupfilter function='member' member='"Corporate"' />
          <groupfilter function='member' member='"Consumer"' />
        </groupfilter>
      </filter>
    </worksheet>
    
    <!-- Worksheet 2: Regional Performance with EXCLUDE LOD -->
    <worksheet name='Regional Performance'>
      <table>
        <panes>
          <pane>
            <mark class='Automatic'>
              <encoding attr='color' column='[Sales.SalesData].[Category]' />
              <encoding attr='size' column='[Sales.SalesData].[Calculation_SalesExcludeState]' />
            </mark>
          </pane>
        </panes>
        <rows>[Sales.SalesData].[Region]</rows>
        <cols>SUM([Sales.SalesData].[Sales])</cols>
      </table>
      <datasource-dependencies datasource='Sales.SalesData'>
        <column name='[Region]' />
        <column name='[Category]' />
        <column name='[Sales]' />
        <column name='[Calculation_SalesExcludeState]' />
      </datasource-dependencies>
    </worksheet>
    
    <!-- Worksheet 3: Cohort Analysis with Complex LOD -->
    <worksheet name='Cohort Analysis'>
      <table>
        <panes>
          <pane>
            <mark class='area' />
          </pane>
        </panes>
        <rows>[Sales.SalesData].[Calculation_CohortSales]</rows>
        <cols>DATETRUNC("month", [Sales.SalesData].[Order Date])</cols>
      </table>
      <datasource-dependencies datasource='Sales.SalesData'>
        <column name='[Order Date]' />
        <column name='[Calculation_CohortSales]' />
        <column name='[Calculation_FirstOrderDate]' />
      </datasource-dependencies>
    </worksheet>
    
    <!-- Worksheet 4: Customer Contribution -->
    <worksheet name='Customer Contribution'>
      <table>
        <panes>
          <pane>
            <mark class='bar' />
          </pane>
        </panes>
        <rows>[Sales.SalesData].[Calculation_CustomerVsTotal]</rows>
        <cols>[Sales.SalesData].[Customer Name]</cols>
      </table>
      <datasource-dependencies datasource='Sales.SalesData'>
        <column name='[Customer Name]' />
        <column name='[Calculation_CustomerVsTotal]' />
      </datasource-dependencies>
      <filter column='[Sales.SalesData].[Calculation_TopCustomerFlag]'>
        <groupfilter function='member' member='true' />
      </filter>
    </worksheet>
  </worksheets>
  
  <dashboards>
    <dashboard name='LOD Analysis Dashboard'>
      <size maxwidth='1400' maxheight='900' />
      <zones>
        <zone name='Customer LOD Analysis' type='worksheet' x='0' y='0' w='700' h='450' />
        <zone name='Regional Performance' type='worksheet' x='700' y='0' w='700' h='450' />
        <zone name='Cohort Analysis' type='worksheet' x='0' y='450' w='700' h='450' />
        <zone name='Customer Contribution' type='worksheet' x='700' y='450' w='700' h='450' />
        <zone type='text' x='550' y='20' w='300' h='40'>
          <formatted-text>
            <run>LOD Expression Analysis Dashboard</run>
          </formatted-text>
        </zone>
      </zones>
      <actions>
        <action name='Filter by Customer' type='filter'>
          <source worksheet='Customer LOD Analysis' />
          <target worksheet='Customer Contribution' />
        </action>
        <action name='Highlight Region' type='highlight'>
          <source worksheet='Regional Performance' />
          <target worksheet='Cohort Analysis' />
        </action>
      </actions>
    </dashboard>
  </dashboards>
</workbook>
