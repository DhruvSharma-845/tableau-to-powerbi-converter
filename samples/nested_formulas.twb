<?xml version='1.0' encoding='utf-8' ?>
<!--
Nested Formulas Sample
Tests complex nested calculations: date functions, string manipulation,
conditional logic, numeric operations, and type conversions
Conversion complexity: HIGH
-->
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource name='Parameters'>
      <column caption='Date Format' name='[Parameter.DateFormat]' datatype='string' role='dimension'>
        <calculation formula='"YYYY-MM-DD"' />
        <members>
          <member value='"YYYY-MM-DD"' />
          <member value='"MM/DD/YYYY"' />
          <member value='"DD-MMM-YYYY"' />
          <member value='"MMMM D, YYYY"' />
        </members>
      </column>
      
      <column caption='Fiscal Year Start Month' name='[Parameter.FiscalYearStart]' datatype='integer' role='measure'>
        <calculation formula='4' />
        <range granularity='1' min='1' max='12' />
      </column>
      
      <column caption='Currency Symbol' name='[Parameter.CurrencySymbol]' datatype='string' role='dimension'>
        <calculation formula='"$"' />
        <members>
          <member value='"$"' />
          <member value='"€"' />
          <member value='"£"' />
          <member value='"¥"' />
        </members>
      </column>
      
      <column caption='Decimal Places' name='[Parameter.DecimalPlaces]' datatype='integer' role='measure'>
        <calculation formula='2' />
        <range granularity='1' min='0' max='4' />
      </column>
      
      <column caption='Age Threshold' name='[Parameter.AgeThreshold]' datatype='integer' role='measure'>
        <calculation formula='30' />
        <range granularity='1' min='0' max='100' />
      </column>
    </datasource>
    
    <datasource name='Complex.Data' caption='Complex Data'>
      <connection class='hyper' filename='complex_data.hyper'>
        <relation name='Data' table='main_data' type='table' />
      </connection>
      
      <!-- Base columns -->
      <column name='[ID]' caption='ID' datatype='string' role='dimension' />
      <column name='[Full Name]' caption='Full Name' datatype='string' role='dimension' />
      <column name='[Email]' caption='Email' datatype='string' role='dimension' />
      <column name='[Phone]' caption='Phone' datatype='string' role='dimension' />
      <column name='[Address]' caption='Address' datatype='string' role='dimension' />
      <column name='[City]' caption='City' datatype='string' role='dimension' />
      <column name='[State]' caption='State' datatype='string' role='dimension' />
      <column name='[Zip Code]' caption='Zip Code' datatype='string' role='dimension' />
      <column name='[Country]' caption='Country' datatype='string' role='dimension' />
      <column name='[Birth Date]' caption='Birth Date' datatype='date' role='dimension' />
      <column name='[Hire Date]' caption='Hire Date' datatype='date' role='dimension' />
      <column name='[Last Activity Date]' caption='Last Activity Date' datatype='datetime' role='dimension' />
      <column name='[Order Date]' caption='Order Date' datatype='datetime' role='dimension' />
      <column name='[Ship Date]' caption='Ship Date' datatype='datetime' role='dimension' />
      <column name='[Due Date]' caption='Due Date' datatype='datetime' role='dimension' />
      <column name='[Category Code]' caption='Category Code' datatype='string' role='dimension' />
      <column name='[Product Code]' caption='Product Code' datatype='string' role='dimension' />
      <column name='[Status Code]' caption='Status Code' datatype='integer' role='dimension' />
      <column name='[Amount]' caption='Amount' datatype='real' role='measure' aggregation='sum' />
      <column name='[Quantity]' caption='Quantity' datatype='integer' role='measure' aggregation='sum' />
      <column name='[Rate]' caption='Rate' datatype='real' role='measure' aggregation='avg' />
      <column name='[Score]' caption='Score' datatype='real' role='measure' aggregation='avg' />
      
      <!-- ======================= -->
      <!-- STRING FUNCTIONS        -->
      <!-- ======================= -->
      
      <!-- Name parsing -->
      <column name='[Calculation_FirstName]' caption='First Name' datatype='string' role='dimension'>
        <calculation formula='IF CONTAINS([Full Name], " ") 
          THEN LEFT([Full Name], FIND([Full Name], " ") - 1)
          ELSE [Full Name]
        END' />
      </column>
      
      <column name='[Calculation_LastName]' caption='Last Name' datatype='string' role='dimension'>
        <calculation formula='IF CONTAINS([Full Name], " ")
          THEN RIGHT([Full Name], LEN([Full Name]) - FIND([Full Name], " "))
          ELSE ""
        END' />
      </column>
      
      <column name='[Calculation_MiddleInitial]' caption='Middle Initial' datatype='string' role='dimension'>
        <calculation formula='IF LEN([Full Name]) - LEN(REPLACE([Full Name], " ", "")) >= 2
          THEN MID([Full Name], FIND([Full Name], " ") + 1, 1)
          ELSE ""
        END' />
      </column>
      
      <column name='[Calculation_NameInitials]' caption='Name Initials' datatype='string' role='dimension'>
        <calculation formula='UPPER(LEFT([Calculation_FirstName], 1)) + 
          UPPER(LEFT([Calculation_LastName], 1))' />
      </column>
      
      <!-- Email parsing -->
      <column name='[Calculation_EmailUsername]' caption='Email Username' datatype='string' role='dimension'>
        <calculation formula='IF CONTAINS([Email], "@")
          THEN LEFT([Email], FIND([Email], "@") - 1)
          ELSE [Email]
        END' />
      </column>
      
      <column name='[Calculation_EmailDomain]' caption='Email Domain' datatype='string' role='dimension'>
        <calculation formula='IF CONTAINS([Email], "@")
          THEN LOWER(RIGHT([Email], LEN([Email]) - FIND([Email], "@")))
          ELSE ""
        END' />
      </column>
      
      <column name='[Calculation_IsCompanyEmail]' caption='Is Company Email' datatype='boolean' role='dimension'>
        <calculation formula='ENDSWITH([Email], "@company.com") OR ENDSWITH([Email], "@company.co.uk")' />
      </column>
      
      <!-- Phone formatting -->
      <column name='[Calculation_FormattedPhone]' caption='Formatted Phone' datatype='string' role='dimension'>
        <calculation formula='IF LEN(REPLACE(REPLACE(REPLACE(REPLACE([Phone], "-", ""), " ", ""), "(", ""), ")", "")) = 10
          THEN "(" + LEFT(REPLACE(REPLACE(REPLACE(REPLACE([Phone], "-", ""), " ", ""), "(", ""), ")", ""), 3) + ") " +
               MID(REPLACE(REPLACE(REPLACE(REPLACE([Phone], "-", ""), " ", ""), "(", ""), ")", ""), 4, 3) + "-" +
               RIGHT(REPLACE(REPLACE(REPLACE(REPLACE([Phone], "-", ""), " ", ""), "(", ""), ")", ""), 4)
          ELSE [Phone]
        END' />
      </column>
      
      <!-- Address parsing and formatting -->
      <column name='[Calculation_FullAddress]' caption='Full Address' datatype='string' role='dimension'>
        <calculation formula='[Address] + ", " + [City] + ", " + [State] + " " + [Zip Code]' />
      </column>
      
      <column name='[Calculation_StateAbbrev]' caption='State Abbreviation' datatype='string' role='dimension'>
        <calculation formula='UPPER(LEFT([State], 2))' />
      </column>
      
      <!-- Code parsing -->
      <column name='[Calculation_CategoryPrefix]' caption='Category Prefix' datatype='string' role='dimension'>
        <calculation formula='IF CONTAINS([Category Code], "-")
          THEN LEFT([Category Code], FIND([Category Code], "-") - 1)
          ELSE LEFT([Category Code], 3)
        END' />
      </column>
      
      <column name='[Calculation_CategoryNumber]' caption='Category Number' datatype='integer' role='dimension'>
        <calculation formula='INT(
          IF CONTAINS([Category Code], "-")
          THEN MID([Category Code], FIND([Category Code], "-") + 1, 10)
          ELSE RIGHT([Category Code], LEN([Category Code]) - 3)
        )' />
      </column>
      
      <column name='[Calculation_ProductSKU]' caption='Product SKU' datatype='string' role='dimension'>
        <calculation formula='UPPER([Category Code]) + "-" + UPPER([Product Code]) + "-" + STR([ID])' />
      </column>
      
      <!-- Text cleaning -->
      <column name='[Calculation_CleanedName]' caption='Cleaned Name' datatype='string' role='dimension'>
        <calculation formula='TRIM(
          REPLACE(
            REPLACE(
              REPLACE([Full Name], "  ", " "),
              CHR(9), ""
            ),
            CHR(10), ""
          )
        )' />
      </column>
      
      <!-- Status mapping -->
      <column name='[Calculation_StatusText]' caption='Status' datatype='string' role='dimension'>
        <calculation formula='CASE [Status Code]
          WHEN 0 THEN "Inactive"
          WHEN 1 THEN "Active"
          WHEN 2 THEN "Pending"
          WHEN 3 THEN "On Hold"
          WHEN 4 THEN "Completed"
          WHEN 5 THEN "Cancelled"
          WHEN 9 THEN "Archived"
          ELSE "Unknown (" + STR([Status Code]) + ")"
        END' />
      </column>
      
      <!-- ======================= -->
      <!-- DATE FUNCTIONS          -->
      <!-- ======================= -->
      
      <!-- Age calculations -->
      <column name='[Calculation_Age]' caption='Age' datatype='integer' role='measure'>
        <calculation formula='DATEDIFF("year", [Birth Date], TODAY())' />
      </column>
      
      <column name='[Calculation_ExactAge]' caption='Exact Age (Years)' datatype='real' role='measure'>
        <calculation formula='DATEDIFF("day", [Birth Date], TODAY()) / 365.25' />
      </column>
      
      <column name='[Calculation_AgeGroup]' caption='Age Group' datatype='string' role='dimension'>
        <calculation formula='IF [Calculation_Age] &lt; 18 THEN "Under 18"
          ELSEIF [Calculation_Age] &lt; 25 THEN "18-24"
          ELSEIF [Calculation_Age] &lt; 35 THEN "25-34"
          ELSEIF [Calculation_Age] &lt; 45 THEN "35-44"
          ELSEIF [Calculation_Age] &lt; 55 THEN "45-54"
          ELSEIF [Calculation_Age] &lt; 65 THEN "55-64"
          ELSE "65+"
        END' />
      </column>
      
      <column name='[Calculation_IsAboveThreshold]' caption='Above Age Threshold' datatype='boolean' role='dimension'>
        <calculation formula='[Calculation_Age] >= [Parameter.AgeThreshold]' />
      </column>
      
      <!-- Tenure calculations -->
      <column name='[Calculation_TenureYears]' caption='Tenure (Years)' datatype='real' role='measure'>
        <calculation formula='DATEDIFF("year", [Hire Date], TODAY())' />
      </column>
      
      <column name='[Calculation_TenureMonths]' caption='Tenure (Months)' datatype='integer' role='measure'>
        <calculation formula='DATEDIFF("month", [Hire Date], TODAY())' />
      </column>
      
      <column name='[Calculation_TenureDays]' caption='Tenure (Days)' datatype='integer' role='measure'>
        <calculation formula='DATEDIFF("day", [Hire Date], TODAY())' />
      </column>
      
      <column name='[Calculation_TenureBucket]' caption='Tenure Bucket' datatype='string' role='dimension'>
        <calculation formula='IF [Calculation_TenureYears] &lt; 1 THEN "Less than 1 year"
          ELSEIF [Calculation_TenureYears] &lt; 3 THEN "1-2 years"
          ELSEIF [Calculation_TenureYears] &lt; 5 THEN "3-4 years"
          ELSEIF [Calculation_TenureYears] &lt; 10 THEN "5-9 years"
          ELSE "10+ years"
        END' />
      </column>
      
      <!-- Date parts and formatting -->
      <column name='[Calculation_OrderYear]' caption='Order Year' datatype='integer' role='dimension'>
        <calculation formula='YEAR([Order Date])' />
      </column>
      
      <column name='[Calculation_OrderQuarter]' caption='Order Quarter' datatype='string' role='dimension'>
        <calculation formula='"Q" + STR(DATEPART("quarter", [Order Date]))' />
      </column>
      
      <column name='[Calculation_OrderMonth]' caption='Order Month' datatype='string' role='dimension'>
        <calculation formula='DATENAME("month", [Order Date])' />
      </column>
      
      <column name='[Calculation_OrderMonthNum]' caption='Order Month Number' datatype='integer' role='dimension'>
        <calculation formula='MONTH([Order Date])' />
      </column>
      
      <column name='[Calculation_OrderWeek]' caption='Order Week' datatype='integer' role='dimension'>
        <calculation formula='DATEPART("week", [Order Date])' />
      </column>
      
      <column name='[Calculation_OrderDayOfWeek]' caption='Order Day of Week' datatype='string' role='dimension'>
        <calculation formula='DATENAME("weekday", [Order Date])' />
      </column>
      
      <column name='[Calculation_OrderDayNum]' caption='Order Day Number' datatype='integer' role='dimension'>
        <calculation formula='DATEPART("weekday", [Order Date])' />
      </column>
      
      <column name='[Calculation_IsWeekend]' caption='Is Weekend' datatype='boolean' role='dimension'>
        <calculation formula='DATEPART("weekday", [Order Date]) IN (1, 7)' />
      </column>
      
      <!-- Fiscal calendar -->
      <column name='[Calculation_FiscalYear]' caption='Fiscal Year' datatype='integer' role='dimension'>
        <calculation formula='IF MONTH([Order Date]) >= [Parameter.FiscalYearStart]
          THEN YEAR([Order Date]) + 1
          ELSE YEAR([Order Date])
        END' />
      </column>
      
      <column name='[Calculation_FiscalQuarter]' caption='Fiscal Quarter' datatype='string' role='dimension'>
        <calculation formula='"FQ" + STR(
          INT((MONTH([Order Date]) - [Parameter.FiscalYearStart] + 12) % 12 / 3) + 1
        )' />
      </column>
      
      <column name='[Calculation_FiscalMonth]' caption='Fiscal Month' datatype='integer' role='dimension'>
        <calculation formula='((MONTH([Order Date]) - [Parameter.FiscalYearStart] + 12) % 12) + 1' />
      </column>
      
      <!-- Date differences -->
      <column name='[Calculation_DaysToShip]' caption='Days to Ship' datatype='integer' role='measure'>
        <calculation formula='DATEDIFF("day", [Order Date], [Ship Date])' />
      </column>
      
      <column name='[Calculation_ShipDelay]' caption='Ship Delay (Days)' datatype='integer' role='measure'>
        <calculation formula='DATEDIFF("day", [Due Date], [Ship Date])' />
      </column>
      
      <column name='[Calculation_IsLate]' caption='Is Late' datatype='boolean' role='dimension'>
        <calculation formula='[Ship Date] > [Due Date]' />
      </column>
      
      <column name='[Calculation_ShipStatus]' caption='Ship Status' datatype='string' role='dimension'>
        <calculation formula='IF ISNULL([Ship Date]) THEN "Not Shipped"
          ELSEIF [Calculation_ShipDelay] &lt; -3 THEN "Early"
          ELSEIF [Calculation_ShipDelay] &lt;= 0 THEN "On Time"
          ELSEIF [Calculation_ShipDelay] &lt;= 3 THEN "Slightly Late"
          ELSE "Significantly Late"
        END' />
      </column>
      
      <column name='[Calculation_DaysSinceActivity]' caption='Days Since Activity' datatype='integer' role='measure'>
        <calculation formula='DATEDIFF("day", [Last Activity Date], NOW())' />
      </column>
      
      <column name='[Calculation_IsInactive]' caption='Is Inactive' datatype='boolean' role='dimension'>
        <calculation formula='[Calculation_DaysSinceActivity] > 90' />
      </column>
      
      <!-- Date construction -->
      <column name='[Calculation_MonthStart]' caption='Month Start' datatype='date' role='dimension'>
        <calculation formula='DATETRUNC("month", [Order Date])' />
      </column>
      
      <column name='[Calculation_MonthEnd]' caption='Month End' datatype='date' role='dimension'>
        <calculation formula='DATEADD("day", -1, DATEADD("month", 1, DATETRUNC("month", [Order Date])))' />
      </column>
      
      <column name='[Calculation_QuarterStart]' caption='Quarter Start' datatype='date' role='dimension'>
        <calculation formula='DATETRUNC("quarter", [Order Date])' />
      </column>
      
      <column name='[Calculation_YearStart]' caption='Year Start' datatype='date' role='dimension'>
        <calculation formula='MAKEDATE(YEAR([Order Date]), 1, 1)' />
      </column>
      
      <!-- ======================= -->
      <!-- NUMERIC FUNCTIONS       -->
      <!-- ======================= -->
      
      <!-- Rounding and formatting -->
      <column name='[Calculation_RoundedAmount]' caption='Rounded Amount' datatype='real' role='measure'>
        <calculation formula='ROUND([Amount], [Parameter.DecimalPlaces])' />
      </column>
      
      <column name='[Calculation_FormattedAmount]' caption='Formatted Amount' datatype='string' role='dimension'>
        <calculation formula='[Parameter.CurrencySymbol] + STR(ROUND([Amount], 2))' />
      </column>
      
      <column name='[Calculation_AmountBucket]' caption='Amount Bucket' datatype='string' role='dimension'>
        <calculation formula='IF [Amount] &lt; 100 THEN "Under $100"
          ELSEIF [Amount] &lt; 500 THEN "$100-$499"
          ELSEIF [Amount] &lt; 1000 THEN "$500-$999"
          ELSEIF [Amount] &lt; 5000 THEN "$1,000-$4,999"
          ELSEIF [Amount] &lt; 10000 THEN "$5,000-$9,999"
          ELSE "$10,000+"
        END' />
      </column>
      
      <!-- Mathematical operations -->
      <column name='[Calculation_TotalValue]' caption='Total Value' datatype='real' role='measure'>
        <calculation formula='[Amount] * [Quantity]' />
      </column>
      
      <column name='[Calculation_UnitPrice]' caption='Unit Price' datatype='real' role='measure'>
        <calculation formula='ZN([Amount] / [Quantity])' />
      </column>
      
      <column name='[Calculation_MarginRate]' caption='Margin Rate' datatype='real' role='measure'>
        <calculation formula='([Amount] - ([Amount] * [Rate])) / [Amount]' />
      </column>
      
      <column name='[Calculation_GrowthRate]' caption='Growth Rate' datatype='real' role='measure'>
        <calculation formula='(([Amount] / LOOKUP([Amount], -1)) - 1)' />
      </column>
      
      <column name='[Calculation_ScoreNormalized]' caption='Normalized Score' datatype='real' role='measure'>
        <calculation formula='([Score] - MIN([Score])) / (MAX([Score]) - MIN([Score]))' />
      </column>
      
      <column name='[Calculation_ScoreGrade]' caption='Score Grade' datatype='string' role='dimension'>
        <calculation formula='IF [Score] >= 90 THEN "A"
          ELSEIF [Score] >= 80 THEN "B"
          ELSEIF [Score] >= 70 THEN "C"
          ELSEIF [Score] >= 60 THEN "D"
          ELSE "F"
        END' />
      </column>
      
      <column name='[Calculation_Percentile]' caption='Percentile Bucket' datatype='string' role='dimension'>
        <calculation formula='CASE 
          WHEN RANK_PERCENTILE(SUM([Amount])) >= 0.9 THEN "Top 10%"
          WHEN RANK_PERCENTILE(SUM([Amount])) >= 0.75 THEN "Top 25%"
          WHEN RANK_PERCENTILE(SUM([Amount])) >= 0.5 THEN "Top 50%"
          WHEN RANK_PERCENTILE(SUM([Amount])) >= 0.25 THEN "Bottom 50%"
          ELSE "Bottom 25%"
        END' />
      </column>
      
      <!-- ======================= -->
      <!-- COMPLEX NESTED LOGIC    -->
      <!-- ======================= -->
      
      <!-- Multi-condition classification -->
      <column name='[Calculation_CustomerTier]' caption='Customer Tier' datatype='string' role='dimension'>
        <calculation formula='IF [Calculation_TenureYears] >= 5 AND SUM([Amount]) >= 10000 THEN "Platinum"
          ELSEIF ([Calculation_TenureYears] >= 3 AND SUM([Amount]) >= 5000) OR SUM([Amount]) >= 15000 THEN "Gold"
          ELSEIF [Calculation_TenureYears] >= 1 AND SUM([Amount]) >= 1000 THEN "Silver"
          ELSEIF SUM([Amount]) > 0 THEN "Bronze"
          ELSE "Prospect"
        END' />
      </column>
      
      <!-- Risk scoring -->
      <column name='[Calculation_RiskScore]' caption='Risk Score' datatype='integer' role='measure'>
        <calculation formula='(IF [Calculation_IsInactive] THEN 30 ELSE 0 END) +
          (IF [Calculation_IsLate] THEN 20 ELSE 0 END) +
          (IF [Score] &lt; 50 THEN 25 ELSE 0 END) +
          (IF [Amount] &lt; 100 THEN 15 ELSE 0 END) +
          (IF [Calculation_TenureYears] &lt; 1 THEN 10 ELSE 0 END)' />
      </column>
      
      <column name='[Calculation_RiskLevel]' caption='Risk Level' datatype='string' role='dimension'>
        <calculation formula='IF [Calculation_RiskScore] >= 60 THEN "High Risk"
          ELSEIF [Calculation_RiskScore] >= 30 THEN "Medium Risk"
          ELSEIF [Calculation_RiskScore] >= 10 THEN "Low Risk"
          ELSE "Minimal Risk"
        END' />
      </column>
      
      <!-- Composite ID generation -->
      <column name='[Calculation_CompositeKey]' caption='Composite Key' datatype='string' role='dimension'>
        <calculation formula='UPPER([Calculation_StateAbbrev]) + "-" + 
          RIGHT("00000" + STR([Calculation_CategoryNumber]), 5) + "-" +
          REPLACE(STR([Order Date]), "-", "") + "-" +
          [ID]' />
      </column>
      
      <!-- Conditional aggregation -->
      <column name='[Calculation_HighValueAmount]' caption='High Value Amount' datatype='real' role='measure'>
        <calculation formula='IF [Amount] >= 1000 THEN [Amount] ELSE 0 END' />
      </column>
      
      <column name='[Calculation_WeekdayAmount]' caption='Weekday Amount' datatype='real' role='measure'>
        <calculation formula='IF NOT [Calculation_IsWeekend] THEN [Amount] ELSE 0 END' />
      </column>
      
      <column name='[Calculation_ActiveAmount]' caption='Active Customer Amount' datatype='real' role='measure'>
        <calculation formula='IF NOT [Calculation_IsInactive] THEN [Amount] ELSE 0 END' />
      </column>
      
      <!-- Dynamic period comparison -->
      <column name='[Calculation_IsSamePeriodPY]' caption='Same Period Prior Year' datatype='boolean' role='dimension'>
        <calculation formula='YEAR([Order Date]) = YEAR(TODAY()) - 1
          AND MONTH([Order Date]) = MONTH(TODAY())
          AND DAY([Order Date]) &lt;= DAY(TODAY())' />
      </column>
      
      <column name='[Calculation_IsMTD]' caption='Is Month to Date' datatype='boolean' role='dimension'>
        <calculation formula='YEAR([Order Date]) = YEAR(TODAY())
          AND MONTH([Order Date]) = MONTH(TODAY())
          AND DAY([Order Date]) &lt;= DAY(TODAY())' />
      </column>
      
      <column name='[Calculation_IsYTD]' caption='Is Year to Date' datatype='boolean' role='dimension'>
        <calculation formula='YEAR([Order Date]) = YEAR(TODAY())
          AND [Order Date] &lt;= TODAY()' />
      </column>
    </datasource>
  </datasources>
  
  <worksheets>
    <worksheet name='Customer Demographics'>
      <table>
        <panes>
          <pane>
            <mark class='bar'>
              <encoding attr='color' column='[Complex.Data].[Calculation_AgeGroup]' />
            </mark>
          </pane>
        </panes>
        <rows>COUNTD([Complex.Data].[ID])</rows>
        <cols>[Complex.Data].[Calculation_AgeGroup]</cols>
      </table>
      <datasource-dependencies datasource='Complex.Data'>
        <column name='[ID]' />
        <column name='[Calculation_AgeGroup]' />
      </datasource-dependencies>
    </worksheet>
    
    <worksheet name='Tenure Analysis'>
      <table>
        <panes>
          <pane>
            <mark class='bar'>
              <encoding attr='color' column='[Complex.Data].[Calculation_CustomerTier]' />
            </mark>
          </pane>
        </panes>
        <rows>SUM([Complex.Data].[Amount])</rows>
        <cols>[Complex.Data].[Calculation_TenureBucket]</cols>
      </table>
      <datasource-dependencies datasource='Complex.Data'>
        <column name='[Amount]' />
        <column name='[Calculation_TenureBucket]' />
        <column name='[Calculation_CustomerTier]' />
      </datasource-dependencies>
    </worksheet>
    
    <worksheet name='Shipping Performance'>
      <table>
        <panes>
          <pane>
            <mark class='bar'>
              <encoding attr='color' column='[Complex.Data].[Calculation_IsLate]' />
            </mark>
          </pane>
        </panes>
        <rows>COUNTD([Complex.Data].[ID])</rows>
        <cols>[Complex.Data].[Calculation_ShipStatus]</cols>
      </table>
      <datasource-dependencies datasource='Complex.Data'>
        <column name='[ID]' />
        <column name='[Calculation_ShipStatus]' />
        <column name='[Calculation_IsLate]' />
      </datasource-dependencies>
    </worksheet>
    
    <worksheet name='Risk Assessment'>
      <table>
        <panes>
          <pane>
            <mark class='circle'>
              <encoding attr='color' column='[Complex.Data].[Calculation_RiskLevel]' />
              <encoding attr='size' column='[Complex.Data].[Amount]' />
            </mark>
          </pane>
        </panes>
        <rows>[Complex.Data].[Calculation_RiskScore]</rows>
        <cols>[Complex.Data].[Score]</cols>
      </table>
      <datasource-dependencies datasource='Complex.Data'>
        <column name='[Score]' />
        <column name='[Amount]' />
        <column name='[Calculation_RiskScore]' />
        <column name='[Calculation_RiskLevel]' />
      </datasource-dependencies>
    </worksheet>
    
    <worksheet name='Fiscal Calendar Analysis'>
      <table>
        <panes>
          <pane>
            <mark class='line' />
          </pane>
        </panes>
        <rows>SUM([Complex.Data].[Amount])</rows>
        <cols>[Complex.Data].[Calculation_FiscalYear]</cols>
        <cols>[Complex.Data].[Calculation_FiscalQuarter]</cols>
      </table>
      <datasource-dependencies datasource='Complex.Data'>
        <column name='[Amount]' />
        <column name='[Calculation_FiscalYear]' />
        <column name='[Calculation_FiscalQuarter]' />
      </datasource-dependencies>
    </worksheet>
  </worksheets>
  
  <dashboards>
    <dashboard name='Complex Formulas Dashboard'>
      <size maxwidth='1600' maxheight='1000' />
      <zones>
        <zone type='text' x='0' y='0' w='1600' h='50'>
          <formatted-text>
            <run bold='true' fontsize='20'>Advanced Formula Analysis</run>
          </formatted-text>
        </zone>
        
        <zone name='Customer Demographics' type='worksheet' x='0' y='50' w='800' h='300' />
        <zone name='Tenure Analysis' type='worksheet' x='800' y='50' w='800' h='300' />
        <zone name='Shipping Performance' type='worksheet' x='0' y='350' w='533' h='300' />
        <zone name='Risk Assessment' type='worksheet' x='533' y='350' w='534' h='300' />
        <zone name='Fiscal Calendar Analysis' type='worksheet' x='1067' y='350' w='533' h='300' />
        
        <zone type='parameterControl' param='Parameter.FiscalYearStart' x='1350' y='10' w='230' h='30' />
        <zone type='parameterControl' param='Parameter.AgeThreshold' x='1350' y='650' w='230' h='30' />
      </zones>
      
      <actions>
        <action name='Filter Demographics' type='filter'>
          <source worksheet='Customer Demographics' />
          <target worksheet='Tenure Analysis' />
          <target worksheet='Risk Assessment' />
        </action>
        
        <action name='Highlight Risk' type='highlight'>
          <source worksheet='Risk Assessment' />
          <target worksheet='Shipping Performance' />
        </action>
      </actions>
    </dashboard>
  </dashboards>
</workbook>
