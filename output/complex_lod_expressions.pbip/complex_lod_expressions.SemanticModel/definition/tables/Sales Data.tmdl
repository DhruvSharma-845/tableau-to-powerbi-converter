    measure 'Customer % of Total' = (CALCULATE(SUM([Sales]), ALLEXCEPT(Table, 'Customer ID')) / CALCULATE(SUM([Sales]), ALL(Table)))
        lineageTag: 3a8c4503-4f43-48da-8bc3-a3fb616c284c
