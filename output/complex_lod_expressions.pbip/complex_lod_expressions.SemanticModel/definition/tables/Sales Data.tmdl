        lineageTag: 798a7392-9b8c-4830-852e-de30fce8604b
        description: Translated from Tableau: SUM([Sales]) / {FIXED [Category] : SUM([Sales])}...

    measure 'New Customer Sales' = IF([Order Date] = CALCULATE(MIN([Order Date]), ALLEXCEPT(Table, 'Customer ID')), [Sales], 0.0)
        lineageTag: 3eead231-b810-451e-9808-84ccebec4f44
        description: Translated from Tableau: IF [Order Date] = {FIXED [Customer ID] : MIN([Order Date])} THEN [Sales] ELSE 0 END...

    measure 'Is Repeat Customer' = CALCULATE(DISTINCTCOUNT([Order Date]), ALLEXCEPT(Table, 'Customer ID')) > 1.0
        lineageTag: de8df490-5b22-4489-9dfc-e561746fa151
        description: Translated from Tableau: {FIXED [Customer ID] : COUNTD([Order Date])} > 1...

    measure 'Is Top Customer' = CALCULATE(SUM([Sales]), ALLEXCEPT(Table, 'Customer ID')) >= CALCULATE(PERCENTILE(CALCULATE(SUM([Sales]), ALLEXCEPT(Table, 'Customer ID')), 0.9), ALL(Table))
        lineageTag: 05d04165-682e-408a-879a-5a9525da58ee
        description: Translated from Tableau: {FIXED [Customer ID] : SUM([Sales])} >=            {FIXED : PERCENTILE({FIXED [Customer ID] : SUM([S...

    measure 'Cohort Total Sales' = CALCULATE(DATE(YEAR(CALCULATE(MIN([Order Date]), ALLEXCEPT(Table, 'Customer ID'))), MONTH(CALCULATE(MIN([Order Date]), ALLEXCEPT(Table, 'Customer ID'))), 1), ALL(Table))
        lineageTag: 215d3508-2c8f-4dba-b5bb-c1335a0a80ec
        description: Translated from Tableau: {FIXED DATETRUNC("month", {FIXED [Customer ID] : MIN([Order Date])}) : SUM([Sales])}...

    measure 'Date Granularity' = SELECTEDVALUE('Date Granularity'[Value], ""Month"")
